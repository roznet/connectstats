# Copy to .env (gitignored) and fill in. Used by scripts/asc.py (/archive).
# The App Store Connect API key is team-wide: the same values as in
# flyfun-weather / flyfun-forms .env work here. Key needs the App Manager role.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_P8_PATH=
# Optional; defaults to the team in the Xcode project
ASC_TEAM_ID=
