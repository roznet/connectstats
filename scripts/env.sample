# Copy to <repo root>/.env (gitignored) for scripts/asc.py.
# The App Store Connect API key is team-wide: the same one flyfun-weather uses works here.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional — defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_P8_PATH=
# Optional — skips the bundle-id lookup (net.ro-z.connectstats)
ASC_APP_ID=
